{
  "name": "omnipdf-studio-desktop",
  "private": true,
  "version": "2.5.0",
  "description": "OmniPDF Studio Desktop - Native PDF Reader, Converter & Wireless Printer/Scanner App",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist:win": "vite build && electron-builder --win nsis portable",
    "dist:mac": "vite build && electron-builder --mac dmg",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.omnipdf.studio.desktop",
    "productName": "OmniPDF Studio",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
